---
interface Props {
  id: string;
  title: string;
  lead?: string;
}
const { id, title, lead } = Astro.props;
---

<section id={id} class="mt-20 scroll-mt-8" aria-labelledby={`${id}-title`}>
  <h2
    id={`${id}-title`}
    class="text-sm font-semibold tracking-widest text-[var(--color-muted)] uppercase"
  >
    {title}
  </h2>
  {lead && <p class="mt-3 max-w-[70ch] text-[var(--color-muted)]">{lead}</p>}
  <div class="mt-6"><slot /></div>
</section>
