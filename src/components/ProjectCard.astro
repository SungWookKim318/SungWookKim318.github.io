---
interface Props {
  href: string;
  title: string;
  subtitle?: string;
  period: string;
  summary: string;
  meta?: string;
  stack?: string[];
  highlights?: string[];
}
const { href, title, subtitle, period, summary, meta, stack = [], highlights = [] } = Astro.props;
---

<a
  href={href}
  class="group block border-t border-[var(--color-line)] py-6 transition-colors hover:bg-[var(--color-accent)]/5"
>
  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h3 class="text-lg font-semibold group-hover:text-[var(--color-accent)]">{title}</h3>
    {subtitle && <span class="text-sm text-[var(--color-muted)]">{subtitle}</span>}
    <span class="ml-auto text-sm tabular-nums text-[var(--color-muted)]">{period}</span>
  </div>
  {meta && <p class="mt-1 text-sm text-[var(--color-muted)]">{meta}</p>}
  <p class="mt-2 max-w-[70ch] text-[var(--color-muted)]">{summary}</p>
  {highlights.length > 0 && (
    <ul class="mt-3 space-y-1 text-sm text-[var(--color-muted)]">
      {highlights.map((h) => (
        <li class="before:mr-2 before:text-[var(--color-line)] before:content-['—']">{h}</li>
      ))}
    </ul>
  )}
  {stack.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {stack.map((s) => (
        <li class="rounded border border-[var(--color-line)] px-2 py-0.5 text-xs text-[var(--color-muted)]">
          {s}
        </li>
      ))}
    </ul>
  )}
</a>
