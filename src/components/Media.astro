---
// 미디어 한 점. GIF에서 변환한 loop는 자동 재생, 일반 video는 포스터 두고 클릭 재생.
// 원본보다 크게 늘리지 않는다. Wix에서 가져온 학부 시절 이미지 중에는 118px짜리도 있다.
interface Props {
  src: string;
  kind?: 'image' | 'loop' | 'video';
  caption?: string;
  poster?: string;
  width: number;
  height: number;
  eager?: boolean;
}
const { src, kind = 'image', caption, poster, width, height, eager = false } = Astro.props;

const box = 'w-full rounded-lg border border-[var(--color-line)] bg-black/5';
const cap = `max-width: ${width}px`;
---

<figure class="m-0" style={cap}>
  {kind === 'image' && (
    <img
      src={src}
      alt={caption ?? ''}
      width={width}
      height={height}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class={box}
    />
  )}
  {kind === 'loop' && (
    <video
      src={src}
      poster={poster}
      width={width}
      height={height}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      class={box}
    />
  )}
  {kind === 'video' && (
    <video
      src={src}
      poster={poster}
      width={width}
      height={height}
      controls
      playsinline
      preload="none"
      class={box}
    />
  )}
  {caption && (
    <figcaption class="mt-2 text-sm text-[var(--color-muted)]">{caption}</figcaption>
  )}
</figure>
