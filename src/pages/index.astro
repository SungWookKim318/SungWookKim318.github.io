---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const published = ({ data }: { data: { draft: boolean } }) => !data.draft;

const career = (await getCollection('career', published)).sort(byOrder);
const personal = (await getCollection('personal', published)).sort(byOrder);
const academic = (await getCollection('academic', published)).sort(byOrder);

const timeline = [
  { period: '2024.09 –', org: '스튜디오씨드코리아 (Studio XID Korea / ProtoPie)', role: 'Product Development 3 소프트웨어 개발자' },
  { period: '2024.02 – 2024.08', org: '레트리카 (Retrica)', role: 'iOS 그래픽스/렌더러 엔지니어' },
  { period: '2023.02 – 2024.01', org: '피트니스 캔디 (Fitness Candy)', role: 'iOS 엔지니어' },
  { period: '2019.07 – 2022.07', org: '리치빔 (멸치)', role: 'IT사업부 렌더링 개발자 (매니저)' },
  { period: '2012.03 – 2019.08', org: '계명대학교', role: '컴퓨터공학부 게임모바일공학 학사' },
  { period: '2009.03 – 2012.02', org: '매천고등학교', role: '인문계열 - 이과' },
];

---

<Base title="김성욱 | Graphics / Rendering Engine Software Engineer">
  <main class="mx-auto max-w-[1120px] px-6 py-24">
    <header>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">김성욱</h1>
      <p class="mt-3 text-lg text-[var(--color-accent)]">
        Graphics / Rendering Engine Software Engineer
      </p>
      <div class="mt-8 max-w-[62ch] space-y-4 text-[17px] leading-[1.75] text-[var(--color-muted)]">
        <p>
          C++와 OpenGL 기반 3D 엔진 개발로 경력을 시작해, Metal 그래픽스 엔진과 Rust/WebGPU 기반
          Web 렌더러까지 7년 동안 렌더링 엔진과 크로스플랫폼 런타임을 개발해 왔습니다.
        </p>
        <p>
          Windows 저작 도구부터 iOS, Android, Web, HarmonyOS까지 다섯 플랫폼에서
          엔진과 런타임을 다뤘습니다.
        </p>
        <p>
          현재 ProtoPie에서 Kotlin Multiplatform 코어 엔진과 Rust/wgpu 렌더러를 잇는
          New Renderer 프로젝트를 주도하고 있습니다.
        </p>
      </div>
    </header>

    <Section id="timeline" title="Time Line">
      <ul class="divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {timeline.map((t) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[170px_1fr] sm:gap-6">
            <span class="text-sm tabular-nums text-[var(--color-muted)]">{t.period}</span>
            <span>
              <span class="font-medium">{t.org}</span>
              <span class="block text-sm text-[var(--color-muted)]">{t.role}</span>
            </span>
          </li>
        ))}
      </ul>
    </Section>

    <Section id="career" title="Career">
      {career.map((e) => (
        <ProjectCard
          href={`/career/${e.id}`}
          title={e.data.title}
          subtitle={e.data.subtitle}
          period={e.data.period}
          summary={e.data.summary}
          highlights={e.data.highlights}
        />
      ))}
    </Section>

    <Section
      id="personal"
      title="Personal Projects"
      lead="학부 시절 OpenGL로 렌더링 기법을 직접 구현한 개인 프로젝트입니다."
    >
      {personal.map((e) => (
        <ProjectCard
          href={`/personal/${e.id}`}
          title={e.data.title}
          subtitle={e.data.subtitle}
          period={e.data.period}
          summary={e.data.summary}
          stack={e.data.stack}
        />
      ))}
    </Section>

    <Section id="academic" title="Academic Projects" lead="학부 팀 프로젝트입니다.">
      {academic.map((e) => (
        <ProjectCard
          href={`/academic/${e.id}`}
          title={e.data.title}
          subtitle={e.data.subtitle}
          period={e.data.period}
          summary={e.data.summary}
          meta={[e.data.engine, e.data.role, e.data.teamSize].filter(Boolean).join(' · ')}
        />
      ))}
    </Section>

    <Section id="award" title="Award">
      <div class="border-t border-[var(--color-line)] py-5">
        <p class="font-medium">대경권 대학생 프로그래밍 경진대회 우수상</p>
        <p class="mt-1 text-sm text-[var(--color-muted)]">
          경북대학교 총장상 · 2018년 5월 12일
        </p>
        <a
          href="/documents/award-certificate.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-block text-sm text-[var(--color-accent)] underline underline-offset-4"
        >
          상장 보기 ↗
        </a>
      </div>
    </Section>

    <footer
      class="mt-24 border-t border-[var(--color-line)] pt-8 text-sm text-[var(--color-muted)]"
    >
      <a class="underline underline-offset-4" href="mailto:SungWook.Kim318@gmail.com">
        SungWook.Kim318@gmail.com
      </a>
      <span aria-hidden="true"> · </span>
      <a
        class="underline underline-offset-4"
        href="https://www.linkedin.com/in/sungwook-kim-244813152/"
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      >
      <p class="mt-2">© 2026 SungWook Kim</p>
    </footer>
  </main>
</Base>
