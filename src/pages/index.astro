---
import Base from '../layouts/Base.astro';

const timeline = [
  { period: '2024.09 – 현재', org: '스튜디오씨드코리아 (ProtoPie)', role: 'Software Engineer, Engine & Player' },
  { period: '2024.02 – 2024.08', org: '레트리카', role: 'iOS Graphics Engineer' },
  { period: '2023.02 – 2024.01', org: '피트니스 캔디', role: 'iOS Engineer' },
  { period: '2019.07 – 2022.07', org: '리치빔', role: 'Software Engineer, Graphics / iOS' },
  { period: '2012.03 – 2019.08', org: '계명대학교 컴퓨터공학부', role: '게임모바일콘텐츠학과 학사' },
];
---

<Base title="김성욱 | Graphics / Rendering Engine Software Engineer">
  <main class="mx-auto max-w-[880px] px-6 py-24">
    <header>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">김성욱</h1>
      <p class="mt-3 text-lg text-[var(--color-accent)]">
        Graphics / Rendering Engine Software Engineer
      </p>
      <p class="mt-8 max-w-[62ch] text-[17px] leading-[1.75] text-[var(--color-muted)]">
        C++와 OpenGL 기반 3D 엔진 개발로 경력을 시작해, 그래픽스 엔진과 크로스플랫폼 런타임을
        만들어 온 7년 차 소프트웨어 엔지니어입니다. Windows 저작 도구의 OpenGL/C++ 3D 엔진부터
        Metal 기반 모바일 그래픽스 엔진, Rust/wgpu 기반 Web 렌더러까지 설계하고 구현했습니다.
      </p>
    </header>

    <section class="mt-20" aria-labelledby="timeline">
      <h2 id="timeline" class="text-sm font-semibold tracking-widest text-[var(--color-muted)] uppercase">
        Timeline
      </h2>
      <ul class="mt-6 divide-y divide-[var(--color-line)] border-t border-[var(--color-line)]">
        {timeline.map((item) => (
          <li class="grid gap-1 py-5 sm:grid-cols-[180px_1fr] sm:gap-6">
            <span class="text-sm text-[var(--color-muted)] tabular-nums">{item.period}</span>
            <span>
              <span class="font-medium">{item.org}</span>
              <span class="block text-sm text-[var(--color-muted)]">{item.role}</span>
            </span>
          </li>
        ))}
      </ul>
    </section>

    <footer class="mt-24 border-t border-[var(--color-line)] pt-8 text-sm text-[var(--color-muted)]">
      <a class="underline underline-offset-4" href="mailto:SungWook.Kim318@gmail.com">
        SungWook.Kim318@gmail.com
      </a>
      <p class="mt-2">© 2026 SungWook Kim</p>
    </footer>
  </main>
</Base>
