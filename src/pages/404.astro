---
import Base from '../layouts/Base.astro';
---

<Base title="페이지를 찾을 수 없습니다 | 김성욱" description="요청한 페이지가 없습니다.">
  <main class="mx-auto flex min-h-screen max-w-[1120px] flex-col justify-center px-6 py-24">
    <p class="text-sm tracking-widest text-[var(--color-muted)] uppercase">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
      페이지를 찾을 수 없습니다
    </h1>
    <p class="mt-4 max-w-[52ch] text-[var(--color-muted)]">
      주소가 바뀌었거나 없는 페이지입니다.
    </p>
    <a
      href="/"
      class="mt-8 self-start text-[var(--color-accent)] underline underline-offset-4"
    >
      처음으로 돌아가기 →
    </a>
  </main>
</Base>
